    {
      "name": "TC-005 - User cannot use a session owned by another user",
      "item": [
        {
          "name": "TC-005 - User B cannot cash out user A session",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "async function CallApi(Method, Path, Body, Token) {",
                  "  const Header = { 'Content-Type': 'application/json' };",
                  "  if (Token) Header.Authorization = 'Bearer ' + Token;",
                  "  const Request = { method: Method, url: pm.environment.get('baseUrl') + Path, header: Header };",
                  "  if (Body !== undefined) Request.body = { mode: 'raw', raw: JSON.stringify(Body) };",
                  "  return new Promise((Resolve, Reject) => pm.sendRequest(Request, (ErrorObject, Response) => ErrorObject ? Reject(ErrorObject) : Resolve(Response)));",
                  "}",
                  "function Check(Name, Assertion) {",
                  "  let Failure;",
                  "  pm.test('TC-005 - ' + Name, function () {",
                  "    try { Assertion(); } catch (ErrorObject) { Failure = ErrorObject; throw ErrorObject; }",
                  "  });",
                  "  if (Failure) throw Failure;",
                  "}",
                  "async function Read(Path, Token, Label) {",
                  "  const Response = await CallApi('GET', Path, undefined, Token);",
                  "  Check(Label + ' returns 200', () => pm.expect(Response.code).to.eql(200));",
                  "  return Response.json();",
                  "}",
                  "",
                  "(async function () {",
                  "  for (const Key of ['tc005TokenA', 'tc005TokenB', 'tc005SessionId', 'tc005MachineId', 'tc005Before']) pm.variables.unset(Key);",
                  "  const Email = pm.environment.get('tc005AdminEmail');",
                  "  const Password = pm.environment.get('tc005AdminPassword');",
                  "  if (!Email || !Password) throw new Error('Run npm run test:api:tc005 for automatic setup, or provide test administrator credentials.');",
                  "  const AdminLogin = await CallApi('POST', '/auth/login', { Email: Email, Password: Password });",
                  "  Check('machine setup authenticates an administrator', () => {",
                  "    pm.expect(AdminLogin.code).to.eql(200);",
                  "    pm.expect(AdminLogin.json().User.Email).to.eql(Email);",
                  "    pm.expect(AdminLogin.json().User.UserType).to.eql('Admin');",
                  "    pm.expect(AdminLogin.json().Token).to.be.a('string').and.not.empty;",
                  "  });",
                  "  const Suffix = pm.variables.replaceIn('{{$guid}}');",
                  "  const MachineName = pm.environment.get('tc005SlotMachineName') || ('TC005 Slot Machine ' + Suffix);",
                  "  const Machine = await CallApi('POST', '/slot/machine', { Name: MachineName, Description: 'TC-005 isolated ownership test', MinimumSpinValue: 0, MinimumChipsRequired: 0, MinimumRerollValue: 0 }, AdminLogin.json().Token);",
                  "  Check('dedicated machine is created through the API', () => {",
                  "    pm.expect(Machine.code).to.eql(201);",
                  "    pm.expect(Machine.json().Name).to.eql(MachineName);",
                  "    pm.expect(Machine.json().Active).to.eql(true);",
                  "    pm.expect(Number.isInteger(Machine.json().SlotMachineId)).to.eql(true);",
                  "    pm.expect(Machine.json().SlotMachineId).to.be.above(0);",
                  "  });",
                  "  const MachineId = Machine.json().SlotMachineId;",
                  "  pm.variables.set('tc005MachineId', MachineId);",
                  "  async function CreateUser(Label) {",
                  "    const Email = pm.environment.get('tc005User' + Label + 'Email') || ('tc005.' + Label.toLowerCase() + '.' + Suffix + '@example.test');",
                  "    const Password = pm.variables.replaceIn('{{$guid}}') + 'Aa1!';",
                  "    const Registered = await CallApi('POST', '/auth/register', { Name: 'TC005 User ' + Label, BirthDate: '1995-01-01', Nickname: 'tc005' + Label + Suffix, Email: Email, Password: Password });",
                  "    Check('user ' + Label + ' is registered as a regular user', () => {",
                  "      pm.expect(Registered.code).to.eql(201);",
                  "      pm.expect(Registered.json().User.Email).to.eql(Email);",
                  "      pm.expect(Registered.json().User.UserType).to.eql('User');",
                  "    });",
                  "    const Login = await CallApi('POST', '/auth/login', { Email: Email, Password: Password });",
                  "    Check('user ' + Label + ' logs in and obtains its own JWT', () => {",
                  "      pm.expect(Login.code).to.eql(200);",
                  "      pm.expect(Login.json().User.UserId).to.eql(Registered.json().User.UserId);",
                  "      pm.expect(Login.json().User.UserType).to.eql('User');",
                  "      pm.expect(Login.json().Token).to.be.a('string').and.not.empty;",
                  "      pm.expect(Login.json().Token.split('.')).to.have.length(3);",
                  "    });",
                  "    return { id: Login.json().User.UserId, token: Login.json().Token };",
                  "  }",
                  "  const A = await CreateUser('A');",
                  "  pm.variables.set('tc005TokenA', A.token);",
                  "  const Created = await CallApi('POST', '/slot-machines/' + MachineId + '/sessions', {}, A.token);",
                  "  Check('A creates a real in-progress session with a generated ID', () => {",
                  "    pm.expect(Created.code).to.eql(201);",
                  "    const Session = Created.json().session;",
                  "    pm.expect(Session.UserId).to.eql(A.id);",
                  "    pm.expect(Session.SlotMachineId).to.eql(MachineId);",
                  "    pm.expect(Session.Status).to.eql('InProgress');",
                  "    pm.expect(Number.isInteger(Session.SlotSessionId)).to.eql(true);",
                  "    pm.expect(Session.SlotSessionId).to.be.above(0);",
                  "  });",
                  "  const SessionId = Created.json().session.SlotSessionId;",
                  "  pm.variables.set('tc005SessionId', SessionId);",
                  "  const B = await CreateUser('B');",
                  "  pm.variables.set('tc005TokenB', B.token);",
                  "  Check('A and B have different identities and tokens', () => {",
                  "    pm.expect(A.id).to.not.eql(B.id);",
                  "    pm.expect(A.token).to.not.eql(B.token);",
                  "  });",
                  "  const ProfileB = await Read('/user/profile', B.token, 'B authenticated profile');",
                  "  Check('B token authenticates B independently of the rejected action', () => {",
                  "    pm.expect(ProfileB.UserId).to.eql(B.id);",
                  "    pm.expect(ProfileB.UserType).to.eql('User');",
                  "  });",
                  "  const Session = await Read('/sessions/active', A.token, 'A session before attempt');",
                  "  const Registry = await Read('/sessions/me/active', A.token, 'A registry before attempt');",
                  "  const BalanceA = await Read('/user/chips', A.token, 'A balance before attempt');",
                  "  const BalanceB = await Read('/user/chips', B.token, 'B balance before attempt');",
                  "  Check('baseline identifies the actual session owned by A', () => {",
                  "    pm.expect(Session).to.deep.equal(Created.json().session);",
                  "    pm.expect(Session.UserId).to.eql(A.id);",
                  "    pm.expect(Registry.UserId).to.eql(A.id);",
                  "    pm.expect(Registry.ReferenceId).to.eql(SessionId);",
                  "    pm.expect(Registry.GameType).to.eql('Slot');",
                  "    pm.expect(BalanceA.ChipBalance).to.be.a('number');",
                  "    pm.expect(BalanceB.ChipBalance).to.be.a('number');",
                  "  });",
                  "  pm.variables.set('tc005Before', JSON.stringify({ session: Session, registry: Registry, balanceA: BalanceA, balanceB: BalanceB }));",
                  "})().catch(ErrorObject => {",
                  "  pm.test('TC-005 - preparation completes', () => { throw ErrorObject; });",
                  "  pm.execution.skipRequest();",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "async function CallApi(Method, Path, Body, Token) {",
                  "  const Header = { 'Content-Type': 'application/json' };",
                  "  if (Token) Header.Authorization = 'Bearer ' + Token;",
                  "  const Request = { method: Method, url: pm.environment.get('baseUrl') + Path, header: Header };",
                  "  if (Body !== undefined) Request.body = { mode: 'raw', raw: JSON.stringify(Body) };",
                  "  return new Promise((Resolve, Reject) => pm.sendRequest(Request, (ErrorObject, Response) => ErrorObject ? Reject(ErrorObject) : Resolve(Response)));",
                  "}",
                  "function Check(Name, Assertion) {",
                  "  let Failure;",
                  "  pm.test('TC-005 - ' + Name, function () {",
                  "    try { Assertion(); } catch (ErrorObject) { Failure = ErrorObject; throw ErrorObject; }",
                  "  });",
                  "  if (Failure) throw Failure;",
                  "}",
                  "async function Read(Path, Token, Label) {",
                  "  const Response = await CallApi('GET', Path, undefined, Token);",
                  "  Check(Label + ' returns 200', () => pm.expect(Response.code).to.eql(200));",
                  "  return Response.json();",
                  "}",
                  "",
                  "(async function () {",
                  "  const TokenA = pm.variables.get('tc005TokenA');",
                  "  const TokenB = pm.variables.get('tc005TokenB');",
                  "  const Before = JSON.parse(pm.variables.get('tc005Before'));",
                  "  const Path = '/slot-machines/' + Before.session.SlotMachineId + '/sessions/' + Before.session.SlotSessionId + '/cash-out';",
                  "  Check('B sends its own JWT to the exact session created by A', () => {",
                  "    pm.expect(TokenB).to.not.eql(TokenA);",
                  "    pm.expect(pm.variables.replaceIn(pm.request.headers.get('Authorization'))).to.eql('Bearer ' + TokenB);",
                  "    pm.expect(pm.variables.replaceIn(pm.request.url.toString())).to.eql(pm.environment.get('baseUrl') + Path);",
                  "    pm.expect(Number(pm.variables.get('tc005SessionId'))).to.eql(Before.session.SlotSessionId);",
                  "  });",
                  "  Check('foreign session cash-out returns the implemented 404 error', () => {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "    pm.expect(pm.response.json()).to.deep.equal({ message: 'Session not found', error: 'Not Found', statusCode: 404 });",
                  "  });",
                  "  const After = await Read('/sessions/active', TokenA, 'A session after attempt');",
                  "  Check('all publicly returned session fields remain unchanged', () => pm.expect(After).to.deep.equal(Before.session));",
                  "  const Registry = await Read('/sessions/me/active', TokenA, 'A registry after attempt');",
                  "  Check('A active-session registration remains unchanged', () => pm.expect(Registry).to.deep.equal(Before.registry));",
                  "  const BalanceA = await Read('/user/chips', TokenA, 'A balance after attempt');",
                  "  const BalanceB = await Read('/user/chips', TokenB, 'B balance after attempt');",
                  "  Check('neither user balance changed during the foreign cash-out', () => {",
                  "    pm.expect(BalanceA).to.deep.equal(Before.balanceA);",
                  "    pm.expect(BalanceB).to.deep.equal(Before.balanceB);",
                  "  });",
                  "  const SessionsB = await Read('/slot-machines/' + Before.session.SlotMachineId + '/sessions', TokenB, 'B session list');",
                  "  Check('B cannot see A session in its own session list', () => pm.expect(SessionsB).to.deep.equal([]));",
                  "  const OwnerCashOut = await CallApi('POST', Path, undefined, TokenA);",
                  "  Check('owner A can cash out the same session successfully', () => {",
                  "    pm.expect(OwnerCashOut.code).to.eql(201);",
                  "    pm.expect(OwnerCashOut.json()).to.deep.equal({ message: 'Cash out successful', finalBalance: Before.balanceA.ChipBalance + Before.session.CurrentRewardSnapshot });",
                  "  });",
                  "})().catch(ErrorObject => {",
                  "  pm.test('TC-005 - ownership verification completes', () => { throw ErrorObject; });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tc005TokenB}}"
              }
            ],
            "url": "{{baseUrl}}/slot-machines/{{tc005MachineId}}/sessions/{{tc005SessionId}}/cash-out"
          },
          "response": []
        }
      ]
