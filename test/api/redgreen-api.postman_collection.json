{
  "info": {
    "_postman_id": "20b614a5-6d93-43d7-8916-5bc93352b48e",
    "name": "RedGreen API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-001 - Unregistered user cannot play",
      "item": [
        {
          "name": "TC-001 - POST attempt to start Slot game without JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ExpectedStatus = 401;",
                  "let ResponseJson;",
                  "",
                  "pm.test('TC-001 - request does not send Authorization header', function () {",
                  "  pm.expect(pm.request.headers.get('Authorization')).to.be.oneOf([undefined, null]);",
                  "});",
                  "",
                  "pm.test('TC-001 - backend rejects unauthenticated game start', function () {",
                  "  pm.response.to.have.status(ExpectedStatus);",
                  "});",
                  "",
                  "pm.test('TC-001 - error response matches implemented Unauthorized format', function () {",
                  "  pm.response.to.have.header('Content-Type');",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  ResponseJson = pm.response.json();",
                  "  pm.expect(ResponseJson).to.be.an('object');",
                  "  pm.expect(ResponseJson).to.deep.equal({ message: 'Unauthorized', statusCode: ExpectedStatus });",
                  "});",
                  "",
                  "pm.test('TC-001 - response contains no started session or game state', function () {",
                  "  ResponseJson = ResponseJson || pm.response.json();",
                  "  pm.expect(pm.response.code).to.not.be.oneOf([200, 201]);",
                  "  pm.expect(ResponseJson).to.not.have.property('session');",
                  "  pm.expect(ResponseJson).to.not.have.property('currentBalance');",
                  "  pm.expect(ResponseJson).to.not.have.property('SlotSessionId');",
                  "  pm.expect(ResponseJson).to.not.have.property('ActiveSessionId');",
                  "  pm.expect(ResponseJson).to.not.have.property('CurrentSpinResult');",
                  "  pm.expect(ResponseJson).to.not.have.property('CurrentRewardSnapshot');",
                  "});",
                  "",
                  "pm.test('TC-001 - response does not advertise a created resource', function () {",
                  "  pm.expect(pm.response.headers.get('Location')).to.be.oneOf([undefined, null]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/slot-machines/{{slotMachineId}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["slot-machines", "{{slotMachineId}}", "sessions"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "TC-002 - Regular user cannot use restricted functions",
      "item": [
        {
          "name": "TC-002 - Regular user cannot create gambit table",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function ResolveRequest(Serialized) {",
                  "  const Request = JSON.parse(pm.variables.replaceIn(Serialized));",
                  "  Request.url = Request.url.raw;",
                  "  return Request;",
                  "}",
                  "",
                  "const Suffix = `${Date.now()}${Math.floor(Math.random() * 100000)}`;",
                  "pm.environment.set('tc002UserName', `TC002 Regular User ${Suffix}`);",
                  "pm.environment.set('tc002UserEmail', `tc002.regular.${Suffix}@example.test`);",
                  "pm.environment.set('tc002UserNickname', `tc002regular${Suffix}`);",
                  "pm.environment.set('tc002UserPassword', 'Tc002Password123!');",
                  "pm.environment.set('tc002GambitTableName', `TC002 Unauthorized Gambit Table ${Suffix}`);",
                  "pm.environment.unset('tc002RegularUserToken');",
                  "",
                  "function StopSetup(Stage, ErrorObject) {",
                  "  pm.environment.unset('tc002RegularUserToken');",
                  "  pm.test('TC-002 - ' + Stage + ' setup succeeds', function () {",
                  "    throw new Error(ErrorObject.message || String(ErrorObject));",
                  "  });",
                  "  pm.execution.skipRequest();",
                  "}",
                  "pm.sendRequest(ResolveRequest(\"{\\\"auth\\\":{\\\"type\\\":\\\"noauth\\\"},\\\"method\\\":\\\"POST\\\",\\\"header\\\":[{\\\"key\\\":\\\"Content-Type\\\",\\\"value\\\":\\\"application/json\\\"}],\\\"body\\\":{\\\"mode\\\":\\\"raw\\\",\\\"raw\\\":\\\"{\\\\n  \\\\\\\"Name\\\\\\\": \\\\\\\"{{tc002UserName}}\\\\\\\",\\\\n  \\\\\\\"BirthDate\\\\\\\": \\\\\\\"1995-01-01\\\\\\\",\\\\n  \\\\\\\"Nickname\\\\\\\": \\\\\\\"{{tc002UserNickname}}\\\\\\\",\\\\n  \\\\\\\"Email\\\\\\\": \\\\\\\"{{tc002UserEmail}}\\\\\\\",\\\\n  \\\\\\\"Password\\\\\\\": \\\\\\\"{{tc002UserPassword}}\\\\\\\"\\\\n}\\\",\\\"options\\\":{\\\"raw\\\":{\\\"language\\\":\\\"json\\\"}}},\\\"url\\\":{\\\"raw\\\":\\\"{{baseUrl}}/auth/register\\\",\\\"host\\\":[\\\"{{baseUrl}}\\\"],\\\"path\\\":[\\\"auth\\\",\\\"register\\\"]}}\"), function (ErrorObject, Response) {",
                  "  if (ErrorObject) { StopSetup('registration', ErrorObject); return; }",
                  "  let ResponseJson;",
                  "",
                  "pm.test('TC-002 - regular user registration succeeds', function () {",
                  "  pm.expect(Response.code).to.eql(201);",
                  "  ResponseJson = Response.json();",
                  "  pm.expect(ResponseJson).to.have.property('User');",
                  "  pm.expect(ResponseJson.User).to.have.property('Email', pm.environment.get('tc002UserEmail'));",
                  "});",
                  "",
                  "pm.test('TC-002 - created user is not an administrator', function () {",
                  "  ResponseJson = ResponseJson || Response.json();",
                  "  pm.expect(ResponseJson.User).to.have.property('UserType', 'User');",
                  "  pm.expect(ResponseJson.User.UserType).to.not.eql('Admin');",
                  "});",
                  "  let User;",
                  "  try { User = Response.json().User; } catch (ErrorObject) { StopSetup('registration', ErrorObject); return; }",
                  "  if (Response.code !== 201 || !User || User.UserType !== 'User' || User.Email !== pm.environment.get('tc002UserEmail')) {",
                  "    StopSetup('registration', new Error('Expected a newly registered regular user')); return;",
                  "  }",
                  "  pm.sendRequest(ResolveRequest(\"{\\\"auth\\\":{\\\"type\\\":\\\"noauth\\\"},\\\"method\\\":\\\"POST\\\",\\\"header\\\":[{\\\"key\\\":\\\"Content-Type\\\",\\\"value\\\":\\\"application/json\\\"}],\\\"body\\\":{\\\"mode\\\":\\\"raw\\\",\\\"raw\\\":\\\"{\\\\n  \\\\\\\"Email\\\\\\\": \\\\\\\"{{tc002UserEmail}}\\\\\\\",\\\\n  \\\\\\\"Password\\\\\\\": \\\\\\\"{{tc002UserPassword}}\\\\\\\"\\\\n}\\\",\\\"options\\\":{\\\"raw\\\":{\\\"language\\\":\\\"json\\\"}}},\\\"url\\\":{\\\"raw\\\":\\\"{{baseUrl}}/auth/login\\\",\\\"host\\\":[\\\"{{baseUrl}}\\\"],\\\"path\\\":[\\\"auth\\\",\\\"login\\\"]}}\"), function (ErrorObject, Response) {",
                  "    if (ErrorObject) { StopSetup('login', ErrorObject); return; }",
                  "    let ResponseJson;",
                  "",
                  "pm.test('TC-002 - regular user login succeeds', function () {",
                  "  pm.expect(Response.code).to.eql(200);",
                  "  ResponseJson = Response.json();",
                  "  pm.expect(ResponseJson).to.have.property('User');",
                  "  pm.expect(ResponseJson.User).to.have.property('Email', pm.environment.get('tc002UserEmail'));",
                  "  pm.expect(ResponseJson.User).to.have.property('UserType', 'User');",
                  "});",
                  "",
                  "pm.test('TC-002 - login returns a valid-looking JWT', function () {",
                  "  ResponseJson = ResponseJson || Response.json();",
                  "  pm.expect(ResponseJson).to.have.property('Token');",
                  "  pm.expect(ResponseJson.Token).to.be.a('string').and.not.empty;",
                  "  pm.expect(ResponseJson.Token.split('.')).to.have.length(3);",
                  "  pm.environment.set('tc002RegularUserToken', ResponseJson.Token);",
                  "});",
                  "    let Result;",
                  "    try { Result = Response.json(); } catch (ErrorObject) { StopSetup('login', ErrorObject); return; }",
                  "    if (Response.code !== 200 || !Result.User || Result.User.UserType !== 'User' || Result.User.Email !== pm.environment.get('tc002UserEmail') || typeof Result.Token !== 'string' || Result.Token.split('.').length !== 3) {",
                  "      StopSetup('login', new Error('Expected the regular user and a JWT')); return;",
                  "    }",
                  "    pm.environment.set('tc002RegularUserToken', Result.Token);",
                  "  });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function ResolveRequest(Serialized) {",
                  "  const Request = JSON.parse(pm.variables.replaceIn(Serialized));",
                  "  Request.url = Request.url.raw;",
                  "  return Request;",
                  "}",
                  "",
                  "const ExpectedStatus = 401;",
                  "let ResponseJson;",
                  "",
                  "pm.test('TC-002 - admin request is configured with the regular user JWT', function () {",
                  "  const Token = pm.environment.get('tc002RegularUserToken');",
                  "  pm.expect(Token).to.be.a('string').and.not.empty;",
                  "  pm.expect(Token.split('.')).to.have.length(3);",
                  "  pm.expect(pm.variables.replaceIn(pm.request.headers.get('Authorization'))).to.eql('Bearer ' + Token);",
                  "});",
                  "",
                  "pm.test('TC-002 - backend rejects regular user for admin-only operation', function () {",
                  "  pm.response.to.have.status(ExpectedStatus);",
                  "});",
                  "",
                  "pm.test('TC-002 - error response matches implemented AdminGuard format', function () {",
                  "  pm.response.to.have.header('Content-Type');",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  ResponseJson = pm.response.json();",
                  "  pm.expect(ResponseJson).to.be.an('object');",
                  "  pm.expect(ResponseJson).to.have.property('statusCode', ExpectedStatus);",
                  "  pm.expect(ResponseJson).to.have.property('message', 'Admin access required');",
                  "  pm.expect(ResponseJson).to.have.property('error', 'Unauthorized');",
                  "});",
                  "",
                  "pm.test('TC-002 - admin operation was not accepted as a created table', function () {",
                  "  ResponseJson = ResponseJson || pm.response.json();",
                  "  pm.expect(pm.response.code).to.not.be.oneOf([200, 201]);",
                  "  pm.expect(ResponseJson).to.not.have.property('GambitTableId');",
                  "  pm.expect(ResponseJson).to.not.have.property('Active');",
                  "});",
                  "",
                  "pm.sendRequest(ResolveRequest(\"{\\\"auth\\\":{\\\"type\\\":\\\"noauth\\\"},\\\"method\\\":\\\"GET\\\",\\\"header\\\":[],\\\"url\\\":{\\\"raw\\\":\\\"{{baseUrl}}/gambit-table\\\",\\\"host\\\":[\\\"{{baseUrl}}\\\"],\\\"path\\\":[\\\"gambit-table\\\"]}}\"), function (ErrorObject, Response) {",
                  "  pm.test('TC-002 - verification request completes', function () {",
                  "    pm.expect(ErrorObject).to.not.exist;",
                  "  });",
                  "  if (ErrorObject) return;",
                  "  pm.test('TC-002 - gambit table list is readable for verification', function () {",
                  "  pm.expect(Response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test('TC-002 - unauthorized admin operation did not create a table', function () {",
                  "  const ResponseJson = Response.json();",
                  "  const AttemptedName = pm.environment.get('tc002GambitTableName');",
                  "  pm.expect(ResponseJson).to.be.an('array');",
                  "  pm.expect(ResponseJson.some((Table) => Table.Name === AttemptedName)).to.eql(false);",
                  "});",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tc002RegularUserToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Name\": \"{{tc002GambitTableName}}\",\n  \"Description\": \"TC-002 unauthorized admin operation attempt\",\n  \"MinimumChipsRequired\": 0,\n  \"CardPrice\": 10,\n  \"TableMultiplier\": 1,\n  \"MinimumCardsPurchased\": 1,\n  \"MaxCardsPurchased\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/gambit-table",
              "host": ["{{baseUrl}}"],
              "path": ["gambit-table"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "TC-003 - Administrator can use restricted functions",
      "item": [
        {
          "name": "TC-003 - Administrator can create gambit table",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.unset('tc003AdminToken');",
                  "pm.variables.unset('tc003ExpectedTable');",
                  "const Email = pm.environment.get('tc003AdminEmail');",
                  "const Password = pm.environment.get('tc003AdminPassword');",
                  "function StopSetup(ErrorObject) {",
                  "  pm.test('TC-003 - administrator setup succeeds', function () { throw ErrorObject; });",
                  "  pm.execution.skipRequest();",
                  "}",
                  "if (!Email || !Password) {",
                  "  StopSetup(new Error('Provide test administrator credentials or run npm run test:api:tc003 for automatic local preparation.'));",
                  "} else {",
                  "  const Name = pm.environment.get('tc003GambitTableName') || ('TC003 Admin Table ' + pm.variables.replaceIn('{{$guid}}'));",
                  "  const Table = { Name: Name, Description: 'TC-003 administrative access test', MinimumChipsRequired: 0, CardPrice: 10, TableMultiplier: 1, MinimumCardsPurchased: 5, MaxCardsPurchased: 20 };",
                  "  pm.variables.set('tc003ExpectedTable', JSON.stringify(Table));",
                  "  pm.sendRequest({",
                  "    url: pm.environment.get('baseUrl') + '/auth/login',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ Email: Email, Password: Password }) }",
                  "  }, function (ErrorObject, Response) {",
                  "    if (ErrorObject) { StopSetup(new Error('Administrator login request failed')); return; }",
                  "    pm.test('TC-003 - administrator login returns 200', function () { pm.expect(Response.code).to.eql(200); });",
                  "    let Data;",
                  "    try { Data = Response.json(); } catch (ErrorObject) { StopSetup(ErrorObject); return; }",
                  "    pm.test('TC-003 - authenticated user is the active administrator', function () {",
                  "      pm.expect(Data.User.Email).to.eql(Email);",
                  "      pm.expect(Data.User.UserType).to.eql('Admin');",
                  "      pm.expect(Data.User.Active).to.eql(true);",
                  "      pm.expect(Data.User.UserId).to.be.a('string').and.not.empty;",
                  "    });",
                  "    pm.test('TC-003 - login supplies a JWT', function () {",
                  "      pm.expect(Data.Token).to.be.a('string').and.not.empty;",
                  "      pm.expect(Data.Token.split('.')).to.have.length(3);",
                  "    });",
                  "    if (Response.code !== 200 || !Data.User || Data.User.Email !== Email || Data.User.UserType !== 'Admin' || !Data.User.Active || typeof Data.Token !== 'string' || Data.Token.split('.').length !== 3) {",
                  "      StopSetup(new Error('Login must authenticate an active administrator and return a JWT')); return;",
                  "    }",
                  "    pm.variables.set('tc003AdminToken', Data.Token);",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const Expected = JSON.parse(pm.variables.get('tc003ExpectedTable'));",
                  "pm.test('TC-003 - request sends the administrator JWT', function () {",
                  "  const Token = pm.variables.get('tc003AdminToken');",
                  "  pm.expect(Token).to.be.a('string').and.not.empty;",
                  "  pm.expect(pm.variables.replaceIn(pm.request.headers.get('Authorization'))).to.eql('Bearer ' + Token);",
                  "});",
                  "pm.test('TC-003 - administrative creation returns 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('TC-003 - creation returns JSON', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "const Created = pm.response.json();",
                  "pm.test('TC-003 - created table matches submitted fields and is active', function () {",
                  "  pm.expect(Created).to.include(Expected);",
                  "  pm.expect(Created.Active).to.eql(true);",
                  "});",
                  "pm.test('TC-003 - created table has a generated positive integer ID', function () {",
                  "  pm.expect(Number.isInteger(Created.GambitTableId)).to.eql(true);",
                  "  pm.expect(Created.GambitTableId).to.be.above(0);",
                  "});",
                  "if (pm.response.code === 201 && Number.isInteger(Created.GambitTableId) && Created.GambitTableId > 0) {",
                  "  pm.sendRequest({ url: pm.environment.get('baseUrl') + '/gambit-table/' + Created.GambitTableId, method: 'GET' }, function (ErrorObject, Response) {",
                  "    pm.test('TC-003 - created table can be retrieved through the API', function () {",
                  "      pm.expect(ErrorObject).to.not.exist;",
                  "      pm.expect(Response.code).to.eql(200);",
                  "    });",
                  "    if (ErrorObject) return;",
                  "    pm.test('TC-003 - persisted table matches the created table', function () {",
                  "      const Persisted = Response.json();",
                  "      pm.expect(Persisted).to.include(Expected);",
                  "      pm.expect(Persisted.GambitTableId).to.eql(Created.GambitTableId);",
                  "      pm.expect(Persisted.Active).to.eql(true);",
                  "    });",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tc003AdminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{tc003ExpectedTable}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/gambit-table"
          },
          "response": []
        }
      ]
    },
    {
      "name": "TC-004 - Daily bonus cannot be claimed more than once per day",
      "item": [
        {
          "name": "TC-004 - Daily bonus cannot be credited twice on the same day",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "async function CallApi(Method, Path, Body, Token) {",
                  "  const Header = { 'Content-Type': 'application/json' };",
                  "  if (Token) Header.Authorization = 'Bearer ' + Token;",
                  "  const Request = { method: Method, url: pm.environment.get('baseUrl') + Path, header: Header };",
                  "  if (Body !== undefined) Request.body = { mode: 'raw', raw: JSON.stringify(Body) };",
                  "  return new Promise((Resolve, Reject) => pm.sendRequest(Request, (ErrorObject, Response) => ErrorObject ? Reject(ErrorObject) : Resolve(Response)));",
                  "}",
                  "function Check(Name, Assertion) {",
                  "  let Failure;",
                  "  pm.test('TC-004 - ' + Name, function () {",
                  "    try { Assertion(); } catch (ErrorObject) { Failure = ErrorObject; throw ErrorObject; }",
                  "  });",
                  "  if (Failure) throw Failure;",
                  "}",
                  "",
                  "(async function () {",
                  "  for (const Key of ['tc004Token', 'tc004InitialBalance', 'tc004FirstBalance', 'tc004LastLoginDate', 'tc004UserId']) pm.variables.unset(Key);",
                  "  const Suffix = pm.variables.replaceIn('{{$guid}}');",
                  "  const Email = 'tc004.' + Suffix + '@example.test';",
                  "  const Password = pm.variables.replaceIn('{{$guid}}') + 'Aa1!';",
                  "  const Registered = await CallApi('POST', '/auth/register', { Name: 'TC004 Daily Bonus User', BirthDate: '1995-01-01', Nickname: 'tc004' + Suffix, Email: Email, Password: Password });",
                  "  Check('fresh user is registered with no previous daily claim', () => {",
                  "    pm.expect(Registered.code).to.eql(201);",
                  "    const User = Registered.json().User;",
                  "    pm.expect(User.Email).to.eql(Email);",
                  "    pm.expect(User.UserType).to.eql('User');",
                  "    pm.expect(User.DailyLoginStreak).to.eql(0);",
                  "    pm.expect(User.LastLoginDate).to.be.oneOf([null, undefined]);",
                  "  });",
                  "  const Login = await CallApi('POST', '/auth/login', { Email: Email, Password: Password });",
                  "  Check('login authenticates the newly registered user', () => {",
                  "    pm.expect(Login.code).to.eql(200);",
                  "    pm.expect(Login.json().User.UserId).to.eql(Registered.json().User.UserId);",
                  "    pm.expect(Login.json().User.Email).to.eql(Email);",
                  "  });",
                  "  const Token = Login.json().Token;",
                  "  Check('login returns a JWT', () => {",
                  "    pm.expect(Token).to.be.a('string').and.not.empty;",
                  "    pm.expect(Token.split('.')).to.have.length(3);",
                  "  });",
                  "  pm.variables.set('tc004Token', Token);",
                  "  pm.variables.set('tc004UserId', Login.json().User.UserId);",
                  "  const InitialResponse = await CallApi('GET', '/user/chips', undefined, Token);",
                  "  Check('initial balance is read through the authenticated API', () => {",
                  "    pm.expect(InitialResponse.code).to.eql(200);",
                  "    pm.expect(InitialResponse.json().ChipBalance).to.eql(0);",
                  "  });",
                  "  const Initial = InitialResponse.json().ChipBalance;",
                  "  pm.variables.set('tc004InitialBalance', Initial);",
                  "  const First = await CallApi('POST', '/user/daily-login', undefined, Token);",
                  "  const ExpectedReward = 1 * 50;",
                  "  Check('first daily claim returns 201 and credits the day-one reward', () => {",
                  "    pm.expect(First.code).to.eql(201);",
                  "    pm.expect(First.json()).to.deep.equal({ FirstLoginToday: true, DailyStreak: 1, Reward: ExpectedReward, ChipBalance: Initial + ExpectedReward });",
                  "  });",
                  "  const AfterFirst = await CallApi('GET', '/user/chips', undefined, Token);",
                  "  Check('first reward is persisted in the balance', () => {",
                  "    pm.expect(AfterFirst.code).to.eql(200);",
                  "    pm.expect(AfterFirst.json().ChipBalance).to.eql(Initial + ExpectedReward);",
                  "  });",
                  "  pm.variables.set('tc004FirstBalance', AfterFirst.json().ChipBalance);",
                  "  const Profile = await CallApi('GET', '/user/profile', undefined, Token);",
                  "  Check('first claim persists its date and streak for the same user', () => {",
                  "    pm.expect(Profile.code).to.eql(200);",
                  "    pm.expect(Profile.json().UserId).to.eql(pm.variables.get('tc004UserId'));",
                  "    pm.expect(Profile.json().DailyLoginStreak).to.eql(1);",
                  "    pm.expect(Profile.json().LastLoginDate).to.be.a('string').and.not.empty;",
                  "    pm.expect(Number.isFinite(Date.parse(Profile.json().LastLoginDate))).to.eql(true);",
                  "  });",
                  "  pm.variables.set('tc004LastLoginDate', Profile.json().LastLoginDate);",
                  "})().catch(ErrorObject => {",
                  "  pm.test('TC-004 - preparation completes', () => { throw ErrorObject; });",
                  "  pm.execution.skipRequest();",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "async function CallApi(Method, Path, Body, Token) {",
                  "  const Header = { 'Content-Type': 'application/json' };",
                  "  if (Token) Header.Authorization = 'Bearer ' + Token;",
                  "  const Request = { method: Method, url: pm.environment.get('baseUrl') + Path, header: Header };",
                  "  if (Body !== undefined) Request.body = { mode: 'raw', raw: JSON.stringify(Body) };",
                  "  return new Promise((Resolve, Reject) => pm.sendRequest(Request, (ErrorObject, Response) => ErrorObject ? Reject(ErrorObject) : Resolve(Response)));",
                  "}",
                  "function Check(Name, Assertion) {",
                  "  let Failure;",
                  "  pm.test('TC-004 - ' + Name, function () {",
                  "    try { Assertion(); } catch (ErrorObject) { Failure = ErrorObject; throw ErrorObject; }",
                  "  });",
                  "  if (Failure) throw Failure;",
                  "}",
                  "",
                  "(async function () {",
                  "  const Token = pm.variables.get('tc004Token');",
                  "  const FirstBalance = Number(pm.variables.get('tc004FirstBalance'));",
                  "  Check('second claim uses the same authenticated context', () => {",
                  "    pm.expect(Token).to.be.a('string').and.not.empty;",
                  "    pm.expect(pm.variables.replaceIn(pm.request.headers.get('Authorization'))).to.eql('Bearer ' + Token);",
                  "  });",
                  "  Check('second claim returns the implemented 201 status', () => { pm.response.to.have.status(201); });",
                  "  Check('backend recognizes a same-day repeat and grants zero reward', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "    pm.expect(pm.response.json()).to.deep.equal({ FirstLoginToday: false, DailyStreak: 1, Reward: 0, ChipBalance: FirstBalance });",
                  "  });",
                  "  const FinalBalance = await CallApi('GET', '/user/chips', undefined, Token);",
                  "  Check('persisted balance contains exactly one daily reward', () => {",
                  "    pm.expect(FinalBalance.code).to.eql(200);",
                  "    pm.expect(FinalBalance.json().ChipBalance).to.eql(FirstBalance);",
                  "    pm.expect(FinalBalance.json().ChipBalance - Number(pm.variables.get('tc004InitialBalance'))).to.eql(50);",
                  "  });",
                  "  const FinalProfile = await CallApi('GET', '/user/profile', undefined, Token);",
                  "  Check('repeat leaves the persisted claim date and streak unchanged', () => {",
                  "    pm.expect(FinalProfile.code).to.eql(200);",
                  "    pm.expect(FinalProfile.json().UserId).to.eql(pm.variables.get('tc004UserId'));",
                  "    pm.expect(FinalProfile.json().LastLoginDate).to.eql(pm.variables.get('tc004LastLoginDate'));",
                  "    pm.expect(FinalProfile.json().DailyLoginStreak).to.eql(1);",
                  "    pm.expect(FinalProfile.json().ChipBalance).to.eql(FirstBalance);",
                  "  });",
                  "})().catch(ErrorObject => {",
                  "  pm.test('TC-004 - daily bonus verification completes', () => { throw ErrorObject; });",
                  "});"
                ]
              }
            }
