# Database 
DATABASE_URL=postgres://postgres:postgres@localhost:5432/redgreen
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=redgreen
POSTGRES_PORT=5433
POSTGRES_SSL=false

TEST_DB_POOL_SIZE=5

# JWT
JWT_SECRET=replace-with-a-strong-secret

# Server
PORT=3000

# Jenkins
JENKINS_PORT=8080
JENKINS_PUBLIC_URL=http://localhost:8080/
REPORT_SERVER_PORT=8088
REPORT_SERVER_URL=http://localhost:8088
# REQUIRED: JENKINS_ADMIN_USER and JENKINS_ADMIN_PASSWORD. The setup wizard is disabled, so if either is
# empty Jenkins starts with no user able to log in, and the admin is not meant to be created in the UI.
JENKINS_ADMIN_USER=
# REQUIRED: strong, unique password (16+ characters, not reused elsewhere)
JENKINS_ADMIN_PASSWORD=
# Group id of /var/run/docker.sock: 0 on Docker Desktop, `stat -c %g /var/run/docker.sock` on Linux
DOCKER_SOCKET_GID=0

# Docker Hub: user, access token (Account settings > Personal access tokens) and image repository (user/name)
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
DOCKERHUB_REPO=

# Email
EMAIL_TO=team@example.com,professor@example.com
EMAIL_FROM=jenkins@redgreen.local

# SMTP (Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAILPIT_UI_PORT=8025
