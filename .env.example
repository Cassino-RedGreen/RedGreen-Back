# Database 
DATABASE_URL=postgres://postgres:postgres@localhost:5432/redgreen
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=redgreen
POSTGRES_PORT=5433
POSTGRES_SSL=false

TEST_DB_POOL_SIZE=5

# JWT
JWT_SECRET=replace-with-a-strong-secret

# Server
PORT=3000

# Jenkins
JENKINS_PORT=8080
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-this-password
DOCKER_SOCKET_GID=0

# Docker Hub
DOCKERHUB_USERNAME=your-dockerhub-user
DOCKERHUB_TOKEN=dckr_pat_replace-me
DOCKERHUB_REPO=your-dockerhub-user/redgreen-back

# Email
EMAIL_TO=team@example.com,professor@example.com
EMAIL_FROM=jenkins@redgreen.local

# SMTP (Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAILPIT_UI_PORT=8025
